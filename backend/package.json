{
  "name": "youtube-autopilot",
  "version": "1.0.0",
  "private": true,
  "description": "Free, fully AI-generated YouTube pipeline: topic -> AI storyboard script -> AI voice -> AI images/clips -> rendered video -> thumbnail -> upload",
  "type": "module",
  "scripts": {
    "run": "node src/run-pipeline.js",
    "dry-run": "node src/run-pipeline.js --dry-run",
    "mock": "MOCK_AI=1 node src/run-pipeline.js --dry-run",
    "get-token": "node scripts/get-refresh-token.js",
    "fetch-analytics": "node scripts/fetch-analytics.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^140.0.1",
    "msedge-tts": "^2.1.0",
    "open": "^10.1.0",
    "sharp": "^0.34.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "msedge-tts@2.1.0": true
  }
}
