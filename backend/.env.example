# Copy to .env for LOCAL runs only. In CI these are GitHub Actions secrets.

# --- Cloudflare Workers AI (free: 10,000 neurons/day) ----------------------
# Script LLM + scene images + backup voice. Token template: "Workers AI".
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CF_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CF_TEXT_FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
#   (@cf/black-forest-labs/flux-2-klein-4b = native 9:16/16:9, ~2x neurons)

# --- Pollinations.ai (optional) --------------------------------------------
# Image fallback + AI motion clips for hook scenes. https://enter.pollinations.ai
# POLLINATIONS_API_KEY=sk_xxxxxxxxxxxxxxxx
# POLLINATIONS_IMAGE_MODEL=flux
# POLLINATIONS_VIDEO_MODEL=        # unset = provider default

# --- YouTube (Desktop-app OAuth client, shared across channels) ------------
YT_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# One refresh token per channel, from `npm run get-token`
YT_REFRESH_TOKEN_CHANNEL1=xxxxxxxxxxxxxxxxxxxx
YT_REFRESH_TOKEN_CHANNEL2=xxxxxxxxxxxxxxxxxxxx

# --- Local testing switches -------------------------------------------------
# MOCK_AI=1        placeholder AI, fully offline
# DRY_RUN=1        render but don't upload (same as --dry-run)
# KEEP_WORKDIR=1   keep the temp folder with all scene assets
# AI_CLIPS=0       skip AI motion clips
# IMAGE_CONCURRENCY=3
